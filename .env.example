# Binance API Keys
# Get these from: https://www.binance.com/en/my/settings/api-management
# Use RESTRICTED permissions: trading only, no withdraw.
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Trading Settings
SYMBOL=BTCUSDT
TIMEFRAME=1h
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
EMA_FAST=9
EMA_SLOW=21
VOL_PERIOD=20
VOL_MULTIPLIER=1.5
RISK_PER_TRADE=0.01  # 1% of balance
STOP_LOSS_PCT=0.02   # 2% stop loss
TAKE_PROFIT_PCT=0.04 # 4% take profit (2:1 RR)

# Bot Settings
DRY_RUN=True  # Set to False for live trading
LOG_FILE=trading_bot.log